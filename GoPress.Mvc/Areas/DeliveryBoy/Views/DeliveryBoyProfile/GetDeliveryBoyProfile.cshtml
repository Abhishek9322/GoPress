@model GoPress.Mvc.Areas.DeliveryBoy.Models.DeliveryBoyProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";

    var fullName = string.IsNullOrWhiteSpace(Model?.FullName)
        ? "Delivery Boy"
        : Model.FullName.Trim();

    var initials = string.Concat(
        fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(x => char.ToUpperInvariant(x[0]))
    );

    string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not provided"
            : value.Trim();
    }
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/delivery-boy-profile.css"
          asp-append-version="true" />
}

<div class="delivery-profile-page">

    <!-- PAGE HEADER -->
    <div class="delivery-profile-header">

        <div class="delivery-profile-header-content">

            <div class="delivery-profile-header-icon">
                <i class="fa-solid fa-motorcycle"></i>
            </div>

            <div>
                <h2>My Delivery Profile</h2>
                <p>Manage your personal and delivery information.</p>
            </div>

        </div>

        <a asp-area="DeliveryBoy"
           asp-controller="Dashboard"
           asp-action="Dashboard"
           class="delivery-profile-back-btn">

            <i class="fa-solid fa-arrow-left"></i>
            Back to Dashboard

        </a>

    </div>

    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="delivery-profile-alert">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="delivery-profile-success-alert">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    <!-- MAIN PROFILE LAYOUT -->
    <div class="delivery-profile-layout">

        <!-- LEFT SIDEBAR -->
        <aside class="delivery-profile-sidebar">

            <div class="delivery-profile-sidebar-banner">

                <div class="delivery-sidebar-circle circle-one"></div>
                <div class="delivery-sidebar-circle circle-two"></div>

            </div>

            <div class="delivery-profile-sidebar-body">

                <!-- AVATAR -->
                <div class="delivery-profile-avatar">
                    @initials
                </div>

                <h3>@fullName</h3>

                <span class="delivery-profile-badge">
                    <i class="fa-solid fa-circle-check"></i>
                    Delivery Partner
                </span>

                <div class="delivery-profile-sidebar-divider"></div>

                <!-- VEHICLE INFORMATION -->
                <div class="delivery-sidebar-info">

                    <div class="delivery-sidebar-info-icon">
                        <i class="fa-solid fa-motorcycle"></i>
                    </div>

                    <div>
                        <span>Vehicle Number</span>
                        <h4>@DisplayValue(Model?.BikeNumber)</h4>
                    </div>

                </div>

                <!-- EDIT PROFILE BUTTON -->
                <a asp-area="DeliveryBoy"
                   asp-controller="DeliveryBoyProfile"
                   asp-action="GetUpdatedDeliveryBoyProfile"
                   class="delivery-profile-edit-btn">

                    <i class="fa-solid fa-pen-to-square"></i>
                    Edit Profile

                </a>

                <!-- SECURITY NOTE -->
                <div class="delivery-profile-security-note">

                    <i class="fa-solid fa-shield-halved"></i>

                    <div>
                        <strong>Account Security</strong>
                        <p>Keep your personal and delivery details updated.</p>
                    </div>

                </div>

            </div>

        </aside>

        <!-- RIGHT CONTENT -->
        <main class="delivery-profile-content">

            <!-- PERSONAL INFORMATION -->
            <section class="delivery-profile-section">

                <div class="delivery-profile-section-heading">

                    <div class="delivery-profile-section-icon">
                        <i class="fa-solid fa-address-card"></i>
                    </div>

                    <div>
                        <h4>Personal Information</h4>
                        <p>Your registered account details</p>
                    </div>

                </div>

                <div class="delivery-profile-details-grid">

                    <!-- FULL NAME -->
                    <div class="delivery-profile-detail-item">

                        <div class="delivery-profile-detail-icon">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div class="delivery-profile-detail-content">
                            <span>Full Name</span>
                            <strong>@DisplayValue(Model?.FullName)</strong>
                        </div>

                    </div>

                    <!-- EMAIL -->
                    <div class="delivery-profile-detail-item">

                        <div class="delivery-profile-detail-icon">
                            <i class="fa-solid fa-envelope"></i>
                        </div>

                        <div class="delivery-profile-detail-content">
                            <span>Email Address</span>
                            <strong>@DisplayValue(Model?.Email)</strong>
                        </div>

                    </div>

                    <!-- PHONE -->
                    <div class="delivery-profile-detail-item">

                        <div class="delivery-profile-detail-icon">
                            <i class="fa-solid fa-phone"></i>
                        </div>

                        <div class="delivery-profile-detail-content">
                            <span>Phone Number</span>
                            <strong>@DisplayValue(Model?.PhoneNumber)</strong>
                        </div>

                    </div>

                </div>

            </section>

            <!-- ADDRESS INFORMATION -->
            <section class="delivery-profile-section">

                <div class="delivery-profile-section-heading">

                    <div class="delivery-profile-section-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div>
                        <h4>Address Information</h4>
                        <p>Your registered residential address</p>
                    </div>

                </div>

                <div class="delivery-profile-details-grid">

                    <!-- ADDRESS -->
                    <div class="delivery-profile-detail-item delivery-detail-full">

                        <div class="delivery-profile-detail-icon">
                            <i class="fa-solid fa-house"></i>
                        </div>

                        <div class="delivery-profile-detail-content">
                            <span>Address</span>
                            <strong>@DisplayValue(Model?.Address)</strong>
                        </div>

                    </div>

                    <!-- CITY -->
                    <div class="delivery-profile-detail-item">

                        <div class="delivery-profile-detail-icon">
                            <i class="fa-solid fa-city"></i>
                        </div>

                        <div class="delivery-profile-detail-content">
                            <span>City</span>
                            <strong>@DisplayValue(Model?.City)</strong>
                        </div>

                    </div>

                    <!-- STATE -->
                    <div class="delivery-profile-detail-item">

                        <div class="delivery-profile-detail-icon">
                            <i class="fa-solid fa-map"></i>
                        </div>

                        <div class="delivery-profile-detail-content">
                            <span>State</span>
                            <strong>@DisplayValue(Model?.State)</strong>
                        </div>

                    </div>

                    <!-- PINCODE -->
                    <div class="delivery-profile-detail-item">

                        <div class="delivery-profile-detail-icon">
                            <i class="fa-solid fa-location-crosshairs"></i>
                        </div>

                        <div class="delivery-profile-detail-content">
                            <span>Pincode</span>
                            <strong>@DisplayValue(Model?.Pincode)</strong>
                        </div>

                    </div>

                </div>

            </section>

            <!-- VEHICLE INFORMATION -->
            <section class="delivery-profile-section">

                <div class="delivery-profile-section-heading">

                    <div class="delivery-profile-section-icon">
                        <i class="fa-solid fa-motorcycle"></i>
                    </div>

                    <div>
                        <h4>Vehicle Information</h4>
                        <p>Your registered delivery vehicle details</p>
                    </div>

                </div>

                <div class="delivery-profile-details-grid">

                    <!-- BIKE NUMBER -->
                    <div class="delivery-profile-detail-item">

                        <div class="delivery-profile-detail-icon">
                            <i class="fa-solid fa-motorcycle"></i>
                        </div>

                        <div class="delivery-profile-detail-content">
                            <span>Vehicle Registration Number</span>
                            <strong>@DisplayValue(Model?.BikeNumber)</strong>
                        </div>

                    </div>

                </div>

            </section>

            <!-- IDENTITY AND LICENSE INFORMATION -->
            <section class="delivery-profile-section">

                <div class="delivery-profile-section-heading">

                    <div class="delivery-profile-section-icon">
                        <i class="fa-solid fa-file-shield"></i>
                    </div>

                    <div>
                        <h4>Identity & License Information</h4>
                        <p>Your registered identity and driving license details</p>
                    </div>

                </div>

                <div class="delivery-profile-details-grid">

                    <!-- LICENSE NUMBER -->
                    <div class="delivery-profile-detail-item">

                        <div class="delivery-profile-detail-icon">
                            <i class="fa-solid fa-id-card"></i>
                        </div>

                        <div class="delivery-profile-detail-content">
                            <span>Driving License Number</span>
                            <strong>@DisplayValue(Model?.LicenseNumber)</strong>
                        </div>

                    </div>

                    <!-- AADHAAR NUMBER -->
                    <div class="delivery-profile-detail-item">

                        <div class="delivery-profile-detail-icon">
                            <i class="fa-solid fa-fingerprint"></i>
                        </div>

                        <div class="delivery-profile-detail-content">
                            <span>Aadhaar Number</span>
                            <strong>@DisplayValue(Model?.AadhaarNumber)</strong>
                        </div>

                    </div>

                </div>

            </section>

            <!-- ACCOUNT INFORMATION -->
            <div class="delivery-profile-account-info">

                <div class="delivery-profile-account-icon">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>

                <div>
                    <h5>Your Delivery Partner Account</h5>

                    <p>
                        Your GoPress delivery profile contains your personal
                        information, residential address, vehicle details,
                        and identity information. Please ensure your details
                        are accurate and up to date.
                    </p>
                </div>

            </div>

        </main>

    </div>

    <!-- FOOTER -->
    <div class="delivery-profile-footer">

        <span>
            <i class="fa-solid fa-lock"></i>
            Your profile information is protected.
        </span>

        <span class="delivery-profile-brand">
            GoPress <i class="fa-solid fa-shirt"></i>
        </span>

    </div>

</div>