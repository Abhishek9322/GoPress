@model GoPress.Mvc.Areas.ShopOwner.Models.ShopOwnerDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/ShopOwner-Dashboard.css"
          asp-append-version="true" />
}


<div class="dashboard-container">

    <!-- Header -->

    <div class="dashboard-header">

        @* <div> *@

        @*     <h2> *@
        @*         Welcome Back  *@
        @*     </h2> *@

        @*     <p> *@
        @*         Manage your laundry orders from one place. *@
        @*     </p> *@

        @* </div> *@

        <div class="dashboard-date">

            @DateTime.Now.ToString("dddd, dd MMM yyyy")

        </div>

    </div>

    <!-- Statistics -->

    <div class="dashboard-grid">

        <div class="dashboard-card">

            <h5>Total Orders</h5>

            <h2>@Model.TotalOrders</h2>

        </div>

        <div class="dashboard-card">

            <h5>ReadyForPickup Orders</h5>

            <h2>@Model.ReadyForPickupOrders</h2>

        </div>

        <div class="dashboard-card pending">

            <h5>Pending Orders</h5>

            <h2>@Model.PendingOrders</h2>

        </div>

        <div class="dashboard-card accepted">

            <h5>Accepted</h5>

            <h2>@Model.AcceptedOrders</h2>

        </div>

        <div class="dashboard-card PickedUpOrders">

            <h5>PickedUp Orders</h5>

            <h2>@Model.PickedUpOrders</h2>

        </div>

        <div class="dashboard-card OutForDeliveryOrders">

            <h5>Rejected Orders</h5>

            <h2>@Model.RejectedOrders</h2>

        </div>

        <div class="dashboard-card DeliveredOrders">

            <h5>Delivered</h5>

            <h2>@Model.DeliveredOrders</h2>

        </div>

        <div class="dashboard-card TotalRevenue">

            <h5>TotalRevenue</h5>

            <h2>@Model.TotalRevenue</h2>

        </div>

        <div class="dashboard-card TodayOrders">

            <h5>Today Orders</h5>

            <h2>@Model.TodayOrders</h2>

        </div>

        <div class="dashboard-card ThisMonthOrders">

            <h5>ThisMonth Orders</h5>

            <h2>@Model.ThisMonthOrders</h2>

        </div>

    </div>

    <!-- Quick Actions -->

    <div class="action-section">

        <h3>
            Quick Actions
        </h3>

        @* <div class="action-buttons"> *@

        @*     <a asp-area="Customer" *@
        @*        asp-controller="Orders" *@
        @*        asp-action="Create" *@
        @*        class="action-btn"> *@

        @*         New Order *@

        @*     </a> *@

        <a asp-area="Customer"
           asp-controller="Orders"
           asp-action="AllOrders"
           class="action-btn">

            My Orders

        </a>

        <a asp-area="Customer"
           asp-controller="Profile"
           asp-action="Index"
           class="action-btn secondary">

            Profile

        </a>

    </div>

</div>

