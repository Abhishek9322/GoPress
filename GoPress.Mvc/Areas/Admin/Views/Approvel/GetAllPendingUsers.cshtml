@model List<GoPress.Mvc.Areas.Admin.Models.AllPendingUsersPendingViewModel>

@{
    ViewData["Title"] = "Pending Users";
    Layout = "_Layout";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/Admin-PendingUsers.css"
          asp-append-version="true" />
}

<div class="orders-page">

    <!-- ==========================================
         PAGE HEADER
    =========================================== -->

    <div class="orders-header">

        <div class="orders-header-content">

            <div class="orders-header-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div>

                <h2>Pending Users</h2>

                <p>
                    Review and manage users waiting for approval.
                </p>

            </div>

        </div>

    </div>


    <!-- ==========================================
         SUCCESS / ERROR MESSAGE
    =========================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-message success-message">

            <i class="fa-solid fa-circle-check"></i>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert-message error-message">

            <i class="fa-solid fa-circle-exclamation"></i>

            <span>
                @TempData["Error"]
            </span>

        </div>
    }


    <!-- ==========================================
         EMPTY STATE
    =========================================== -->
    @if (Model == null || !Model.Any())
    {
        <div class="orders-empty-state">

            <div class="empty-icon">

                <i class="fa-solid fa-users"></i>

            </div>

            <h3>
                No Pending Users
            </h3>

            <p>
                There are currently no users waiting for approval.
            </p>

        </div>
    }
    else
    {

        <!-- ==========================================
             SUMMARY
        =========================================== -->

        <div class="orders-summary">

            <div>

                <span class="summary-label">
                    Pending Users
                </span>

                <strong>
                    @Model.Count
                </strong>

            </div>

            <div class="summary-description">

                <i class="fa-solid fa-clock"></i>

                Users waiting for admin approval.

            </div>

        </div>


        <!-- ==========================================
             USERS GRID
        =========================================== -->

        <div class="orders-grid">

            @foreach (var user in Model)
            {

                <div class="order-card">

                    <!-- ==========================================
                         CARD HEADER
                    =========================================== -->

                    <div class="order-card-header">

                        <div class="order-number">

                            <span>
                                @user.Role
                            </span>

                            <h3>
                                @user.FullName
                            </h3>

                        </div>

                        <span class="status-badge status-pending">

                            <i class="fa-solid fa-clock"></i>

                            Pending

                        </span>

                    </div>


                    <!-- ==========================================
                         PERSONAL INFORMATION
                    =========================================== -->

                    <div class="customer-section">

                        <div class="customer-header">

                            <h4>

                                <i class="fa-solid fa-user"></i>

                                User Information

                            </h4>

                        </div>


                        <div class="customer-info">

                            <div>

                                <span>
                                    Full Name
                                </span>

                                <strong>
                                    @user.FullName
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Phone
                                </span>

                                <strong>
                                    @user.PhoneNumber
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Email
                                </span>

                                <strong>
                                    @user.Email
                                </strong>

                            </div>


                            <div>

                                <span>
                                    Role
                                </span>

                                <strong>
                                    @user.Role
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- ==========================================
                         CARD FOOTER / ACTIONS
                    =========================================== -->

                    <div class="order-card-footer">

                        <div class="footer-total">

                            <span>
                                Request Status
                            </span>

                            <strong class="pending-text">
                                Pending Approval
                            </strong>

                        </div>


                        <div class="shop-actions">

                            <!-- APPROVE -->

                            <form asp-area="Admin"
                                  asp-controller="Approvel"
                                  asp-action="ApproveUser"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to approve @user.FullName?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@user.UserId" />

                                <button type="submit"
                                        class="approve-btn">

                                    <i class="fa-solid fa-check"></i>

                                    Approve

                                </button>

                            </form>


                            <!-- REJECT -->

                            <form asp-area="Admin"
                                  asp-controller="Approvel"
                                  asp-action="RejectUser"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to reject @user.FullName?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@user.UserId" />

                                <button type="submit"
                                        class="reject-btn">

                                    <i class="fa-solid fa-xmark"></i>

                                    Reject

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            }

        </div>

    }

</div>