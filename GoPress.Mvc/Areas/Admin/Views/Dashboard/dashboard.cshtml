@model GoPress.Mvc.Areas.Admin.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

@section Styles
{
     <link rel="stylesheet"
           href="~/css/Admin-Dashboard.css"
           asp-append-version="true" />

}

<div class="dashboard-container">

    <!-- Header -->

    <div class="dashboard-header">

        @* <div> *@

        @*     <h2> *@
        @*         Welcome Back  *@
        @*     </h2> *@

        @*     <p> *@
        @*         Manage your laundry orders from one place. *@
        @*     </p> *@

        @* </div> *@

        <div class="dashboard-date">

            @DateTime.Now.ToString("dddd, dd MMM yyyy")

        </div>

    </div>

    <!-- Statistics -->

    <div class="dashboard-grid">

        <div class="dashboard-card">

            <h5>Total Customers</h5>

            <h2>@Model.TotalCustomers</h2>

        </div>

        <div class="dashboard-card">

            <h5>Total ShopOwners</h5>

            <h2>@Model.TotalShopOwners</h2>

        </div>

        <div class="dashboard-card TotalDeliveryBoys">

            <h5>Total DeliveryBoys</h5>

            <h2>@Model.TotalDeliveryBoys</h2>

        </div>

        <div class="dashboard-card PendingShopOwnerApprovals">

            <h5>Pending ShopOwner Approvals</h5>

            <h2>@Model.PendingShopOwnerApprovals</h2>

        </div>

        <div class="dashboard-card PendingDeliveryBoyApprovals">

            <h5>Pending DeliveryBoy Approvals</h5>

            <h2>@Model.PendingDeliveryBoyApprovals</h2>

        </div>

        <div class="dashboard-card ActiveUsers">

            <h5>Active Users</h5>

            <h2>@Model.ActiveUsers</h2>

        </div>

        <div class="dashboard-card InactiveUsers">

            <h5>Inactive Users</h5>

            <h2>@Model.InactiveUsers</h2>

        </div>

        <div class="dashboard-card TotalOrders">

            <h5>Total Orders</h5>

            <h2>@Model.TotalOrders</h2>

        </div>

        <div class="dashboard-card PendingOrders">

            <h5>Pending Orders</h5>

            <h2>@Model.PendingOrders</h2>

        </div>

        <div class="dashboard-card CompletedOrders">

            <h5>Completed Orders</h5>

            <h2>@Model.CompletedOrders</h2>

        </div>

    </div>

    <!-- Quick Actions -->

    <div class="action-section">

        <h3>
            Quick Actions
        </h3>

        @* <div class="action-buttons"> *@ 

        @*     <a asp-area="Customer" *@
        @*        asp-controller="Orders" *@
        @*        asp-action="Create" *@
        @*        class="action-btn"> *@

        @*         New Order *@

        @*     </a> *@

        <a asp-area="Customer"
           asp-controller="Orders"
           asp-action="AllOrders"
           class="action-btn">

            My Orders

        </a>

        <a asp-area="Customer"
           asp-controller="Profile"
           asp-action="Index"
           class="action-btn secondary">

            Profile

        </a>

    </div>

</div>

</div>