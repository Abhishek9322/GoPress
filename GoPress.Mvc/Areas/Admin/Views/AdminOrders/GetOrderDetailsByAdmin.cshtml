@model GoPress.Mvc.Areas.Admin.Models.OrdersResponseViewModel

@{
    ViewData["Title"] = "Order Details";
    Layout = "_Layout";

    var statusClass = (Model.Status.ToString() ?? "pending")
        .Replace(" ", "")
        .ToLowerInvariant();

    var customerInitial = !string.IsNullOrWhiteSpace(Model.CustomerName)
        ? Model.CustomerName.Substring(0, 1).ToUpperInvariant()
        : "C";

    var shopInitial = !string.IsNullOrWhiteSpace(Model.ShopOwnerName)
        ? Model.ShopOwnerName.Substring(0, 1).ToUpperInvariant()
        : "S";

    var deliveryInitial = !string.IsNullOrWhiteSpace(Model.DeliveryBoyName)
        ? Model.DeliveryBoyName.Substring(0, 1).ToUpperInvariant()
        : "D";

    var orderItems = Model.OrderItems;
    var itemCount = orderItems?.Count ?? 0;
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/Admin-OrderDetails.css"
          asp-append-version="true" />
}

<div class="od-page">

    <!-- PAGE HEADER -->

    <header class="od-topbar">

        <div class="od-heading">

            <div class="od-heading-icon">
                <i class="fa-solid fa-file-invoice"></i>
            </div>

            <div>
                <div class="od-eyebrow">
                    GOPRESS / ADMIN / ORDERS
                </div>

                <h1>
                    Order Overview
                    <span>#@Model.Id</span>
                </h1>

                <p>
                    Review order details, assigned people, items and delivery information.
                </p>
            </div>

        </div>

        <a asp-area="Admin"
           asp-controller="AdminOrders"
           asp-action="AllOrderByAdmin"
           class="od-back">

            <i class="fa-solid fa-arrow-left"></i>
            Back to orders

        </a>

    </header>


    <!-- ORDER SUMMARY -->

    <section class="od-summary">

        <div class="od-summary-main">

            <div class="od-order-mark">
                <i class="fa-solid fa-bag-shopping"></i>
            </div>

            <div class="od-summary-number">

                <span>ORDER NUMBER</span>

                <strong>#@Model.Id</strong>

            </div>

            <div class="od-summary-separator"></div>

            <div class="od-summary-date">

                <span>
                    <i class="fa-regular fa-calendar"></i>
                    PICKUP SCHEDULE
                </span>

                <strong>
                    @Model.PickupDate.ToString("dd MMM yyyy")
                </strong>

                <small>
                    @Model.PickupDate.ToString("hh:mm tt")
                </small>

            </div>

        </div>


        <div class="od-summary-total">

            <span>ORDER TOTAL</span>

            <strong>
                <small>₹</small>@Model.TotalAmount.ToString("N2")
            </strong>

            <span class="od-status @statusClass">
                <i class="fa-solid fa-circle"></i>
                @Model.Status
            </span>

        </div>

    </section>


    <!-- MAIN LAYOUT -->

    <div class="od-layout">

        <!-- LEFT COLUMN -->

        <main class="od-main-column">


            <!-- CUSTOMER, SHOP OWNER AND DELIVERY PARTNER -->

            <section class="od-panel">

                <div class="od-panel-heading">

                    <div class="od-panel-icon od-cyan">
                        <i class="fa-solid fa-people-arrows-left-right"></i>
                    </div>

                    <div>
                        <h2>People & Assignment</h2>
                        <p>Customer, shop and delivery partner</p>
                    </div>

                </div>


                <div class="od-people-grid">

                    <!-- CUSTOMER -->

                    <div class="od-person">

                        <div class="od-avatar od-avatar-customer">
                            @customerInitial
                        </div>

                        <div class="od-person-details">

                            <span class="od-label">
                                CUSTOMER
                            </span>

                            <strong>
                                @(Model.CustomerName ?? "N/A")
                            </strong>

                            <small>
                                Customer ID: @Model.CustomerId
                            </small>

                        </div>

                    </div>


                    <!-- SHOP OWNER -->

                    <div class="od-person">

                        <div class="od-avatar od-avatar-shop">
                            @shopInitial
                        </div>

                        <div class="od-person-details">

                            <span class="od-label">
                                SHOP OWNER
                            </span>

                            <strong>
                                @(Model.ShopOwnerName ?? "N/A")
                            </strong>

                            <small>
                                Shop Owner ID: @Model.ShopOwnerId
                            </small>

                        </div>

                    </div>


                    <!-- DELIVERY PARTNER -->

                    <div class="od-person">

                        @if (Model.DeliveryBoyId.HasValue)
                        {
                            <div class="od-avatar od-avatar-delivery">
                                @deliveryInitial
                            </div>

                            <div class="od-person-details">

                                <span class="od-label">
                                    DELIVERY PARTNER
                                </span>

                                <strong>
                                    @(Model.DeliveryBoyName ?? "N/A")
                                </strong>

                                <small>
                                    Delivery Boy ID: @Model.DeliveryBoyId
                                </small>

                            </div>
                        }
                        else
                        {
                            <div class="od-avatar od-avatar-unassigned">
                                <i class="fa-solid fa-user-clock"></i>
                            </div>

                            <div class="od-person-details">

                                <span class="od-label">
                                    DELIVERY PARTNER
                                </span>

                                <strong>
                                    Not assigned
                                </strong>

                                <small>
                                    Waiting for a delivery partner
                                </small>

                            </div>
                        }

                    </div>

                </div>

            </section>


            <!-- ORDER ITEMS -->

            <section class="od-panel od-items-panel">

                <div class="od-panel-heading od-items-heading">

                    <div class="od-panel-heading-left">

                        <div class="od-panel-icon od-purple">
                            <i class="fa-solid fa-shirt"></i>
                        </div>

                        <div>
                            <h2>Items in This Order</h2>
                            <p>Cloth details and item pricing</p>
                        </div>

                    </div>

                    <span class="od-count">
                        <i class="fa-solid fa-box"></i>
                        @itemCount items
                    </span>

                </div>


                @if (orderItems != null && orderItems.Any())
                {
                    <div class="od-table-wrap">

                        <table class="od-table">

                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>ITEM / CLOTH</th>
                                    <th>QTY</th>
                                    <th>UNIT PRICE</th>
                                    <th class="od-align-right">TOTAL</th>
                                </tr>
                            </thead>

                            <tbody>

                                @{
                                    var itemNumber = 1;
                                }

                                @foreach (var item in orderItems)
                                {
                                    <tr>

                                        <td>
                                            <span class="od-row-number">
                                                @itemNumber
                                            </span>
                                        </td>

                                        <td>

                                            <div class="od-cloth">

                                                <span class="od-cloth-icon">
                                                    <i class="fa-solid fa-shirt"></i>
                                                </span>

                                                <span>

                                                    <strong>
                                                        @(item.ClothName ?? "Unknown cloth")
                                                    </strong>

                                                    <small>
                                                        Cloth ID: @item.ClothTypeId
                                                    </small>

                                                </span>

                                            </div>

                                        </td>

                                        <td>
                                            <span class="od-quantity">
                                                @item.Quantity
                                            </span>
                                        </td>

                                        <td class="od-unit-price">
                                            ₹@item.Price.ToString("N2")
                                        </td>

                                        <td class="od-align-right">

                                            <strong class="od-line-total">
                                                ₹@item.TotalPrice.ToString("N2")
                                            </strong>

                                        </td>

                                    </tr>

                                    itemNumber++;
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="od-empty">

                        <i class="fa-solid fa-box-open"></i>

                        <strong>No items found</strong>

                        <span>
                            No order items are available for this order.
                        </span>

                    </div>
                }

            </section>


            <!-- PICKUP AND DELIVERY ADDRESSES -->

            <section class="od-panel od-address-panel">

                <div class="od-panel-heading">

                    <div class="od-panel-icon od-blue">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div>
                        <h2>Pickup & Delivery</h2>
                        <p>Order collection and drop-off addresses</p>
                    </div>

                </div>


                <div class="od-address-grid">

                    <!-- PICKUP ADDRESS -->

                    <div class="od-address">

                        <div class="od-address-label">

                            <span class="od-address-dot od-pickup-dot"></span>

                            PICKUP ADDRESS

                        </div>

                        <p>
                            @(string.IsNullOrWhiteSpace(Model.PickupAddress)
                                ? "Address not available"
                                : Model.PickupAddress)
                        </p>

                    </div>


                    <!-- DELIVERY ADDRESS -->

                    <div class="od-address">

                        <div class="od-address-label">

                            <span class="od-address-dot od-delivery-dot"></span>

                            DELIVERY ADDRESS

                        </div>

                        <p>
                            @(string.IsNullOrWhiteSpace(Model.DeliveryAddress)
                                ? "Address not available"
                                : Model.DeliveryAddress)
                        </p>

                    </div>

                </div>

            </section>

        </main>


        <!-- RIGHT COLUMN -->

        <aside class="od-side-column">


            <!-- ORDER PROGRESS -->

            <section class="od-panel od-progress-panel">

                <div class="od-panel-heading">

                    <div class="od-panel-icon od-cyan">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>

                    <div>
                        <h2>Order Progress</h2>
                        <p>Key schedule milestones</p>
                    </div>

                </div>


                <div class="od-progress">

                    <!-- PICKUP -->

                    <div class="od-progress-item is-active">

                        <span class="od-progress-marker">
                            <i class="fa-solid fa-calendar-check"></i>
                        </span>

                        <div>

                            <strong>
                                Pickup scheduled
                            </strong>

                            <span>
                                @Model.PickupDate.ToString("dd MMM yyyy, hh:mm tt")
                            </span>

                        </div>

                    </div>


                    <!-- DELIVERY -->

                    <div class="od-progress-item @(Model.DeliveryDate.HasValue ? "is-active" : "")">

                        <span class="od-progress-marker">

                            @if (Model.DeliveryDate.HasValue)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-clock"></i>
                            }

                        </span>

                        <div>

                            <strong>
                                Delivery
                            </strong>

                            @if (Model.DeliveryDate.HasValue)
                            {
                                <span>
                                    @Model.DeliveryDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                                </span>
                            }
                            else
                            {
                                <span>
                                    Delivery not completed yet
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </section>


            <!-- CUSTOMER NOTES -->

            <section class="od-panel od-notes-panel">

                <div class="od-panel-heading">

                    <div class="od-panel-icon od-amber">
                        <i class="fa-solid fa-note-sticky"></i>
                    </div>

                    <div>
                        <h2>Customer Notes</h2>
                        <p>Special instructions for this order</p>
                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="od-notes">

                        <i class="fa-solid fa-quote-left"></i>

                        <p>
                            @Model.Notes
                        </p>

                    </div>
                }
                else
                {
                    <div class="od-no-notes">

                        <i class="fa-regular fa-note-sticky"></i>

                        <span>
                            No additional notes provided.
                        </span>

                    </div>
                }

            </section>


            <!-- TOTAL AMOUNT -->

            <section class="od-total-panel">

                <div class="od-total-icon">
                    <i class="fa-solid fa-receipt"></i>
                </div>

                <div class="od-total-copy">

                    <span>
                        AMOUNT TO COLLECT
                    </span>

                    <small>
                        @itemCount item(s) in this order
                    </small>

                </div>

                <strong>
                    <small>₹</small>@Model.TotalAmount.ToString("N2")
                </strong>

            </section>

        </aside>

    </div>

</div>
