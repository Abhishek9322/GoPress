@model List<GoPress.Mvc.Areas.Customer.Models.OrderViewModel>

@{
    ViewData["Title"] = "All Orders";
    Layout = "_Layout";
}

@section Styles
{
    <link rel="stylesheet"
    href="~/css/Customer-AllOrders.css"
    asp-append-version="true" />
}

<div class="orders-page">

    <!-- =====================================================
    PAGE HEADER
    ===================================================== -->

    <div class="orders-header">

        <div class="orders-header-content">

            <div class="orders-header-icon">
                <i class="fa-solid fa-bag-shopping"></i>
            </div>

            <div>

                <h2>My Orders</h2>

                <p>
                    Track and manage all your laundry orders in one place.
                </p>

            </div>

        </div>


        <a asp-area="Customer"
        asp-controller="Orders"
        asp-action="Create"
        class="new-order-btn">

            <i class="fa-solid fa-plus"></i>

            <span>New Order</span>

        </a>

    </div>


    @if (!Model.Any())
    {
        <!-- =================================================
        EMPTY STATE
        ================================================= -->

        <div class="orders-empty-state">

            <div class="empty-icon">

                <i class="fa-solid fa-box-open"></i>

            </div>

            <h3>No Orders Yet</h3>

            <p>
                You haven't placed any laundry orders yet.
                Create your first order to get started.
            </p>

            <a asp-area="Customer"
            asp-controller="Orders"
            asp-action="Create"
            class="empty-order-btn">

                <i class="fa-solid fa-plus"></i>

                Create Your First Order

            </a>

        </div>
    }
    else
    {
        <!-- =================================================
        ORDER COUNT
        ================================================= -->

        <div class="orders-summary">

            <div>

                <span class="summary-label">
                    Total Orders
                </span>

                <strong>
                    @Model.Count
                </strong>

            </div>

            <div class="summary-description">

                <i class="fa-solid fa-clock-rotate-left"></i>

                Your recent orders are shown below.

            </div>

        </div>


        <!-- =================================================
        ORDERS GRID
        ================================================= -->

        <div class="orders-grid">

            @foreach (var order in Model)
            {
                var statusClass =
                $"status-{order.Status.ToString().ToLower().Replace("_", "-")}";


                <div class="order-card">

                    <!-- =====================================
                    CARD HEADER
                    ===================================== -->

                    <div class="order-card-header">

                        <div class="order-number">

                            <span>
                                ORDER
                            </span>

                            <h3>
                                #@order.Id
                            </h3>

                        </div>


                        <span class="status-badge @statusClass">

                            @order.Status

                        </span>

                    </div>


                    <!-- =====================================
                    ORDER DATE
                    ===================================== -->

                    <div class="order-date">

                        <i class="fa-regular fa-calendar"></i>

                        <span>
                            Pickup scheduled for
                        </span>

                        <strong>
                            @order.PickupDate.ToString("dd MMM yyyy")
                        </strong>

                    </div>


                    <!-- =====================================
                    ORDER DETAILS
                    ===================================== -->

                    <div class="order-details">

                        <div class="detail-item">

                            <div class="detail-icon pickup-icon">

                                <i class="fa-solid fa-location-dot"></i>

                            </div>

                            <div>

                                <span>
                                    Pickup
                                </span>

                                <strong>
                                    @order.PickupDate.ToString("dd MMM yyyy")
                                </strong>

                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-icon delivery-icon">

                                <i class="fa-solid fa-truck"></i>

                            </div>

                            <div>

                                <span>
                                    Delivery
                                </span>

                                <strong>
                                    @(order.DeliveryDate?.ToString("dd MMM yyyy") ?? "Not scheduled")
                                </strong>

                            </div>

                        </div>


                        <div class="detail-item amount-item">

                            <div class="detail-icon amount-icon">

                                <i class="fa-solid fa-indian-rupee-sign"></i>

                            </div>

                            <div>

                                <span>
                                    Total Amount
                                </span>

                                <strong class="price">
                                    ₹@order.TotalAmount.ToString("N2")
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- =====================================
                    CLOTHES
                    ===================================== -->

                    <div class="clothes-section">

                        <div class="clothes-header">

                            <h4>
                                <i class="fa-solid fa-shirt"></i>
                                Order Items
                            </h4>

                            <span>
                                @order.OrderItems.Count item(s)
                            </span>

                        </div>


                        <div class="clothes-list">

                            @foreach (var item in order.OrderItems)
                            {
                                <div class="cloth-item">

                                    <div class="cloth-info">

                                        <div class="cloth-icon">

                                            <i class="fa-solid fa-shirt"></i>

                                        </div>

                                        <div>

                                            <strong>
                                                @item.ClothName
                                            </strong>

                                            <span>
                                                Quantity: @item.Quantity
                                            </span>

                                        </div>

                                    </div>


                                    <div class="cloth-price">

                                        ₹@item.TotalPrice.ToString("N2")

                                    </div>

                                </div>
                            }

                        </div>

                    </div>


                    <!-- =====================================
                    FOOTER
                    ===================================== -->

                    <div class="order-card-footer">

                        <div class="footer-total">

                            <span>
                                Order Total
                            </span>

                            <strong>
                                ₹@order.TotalAmount.ToString("N2")
                            </strong>

                        </div>

                        @if (order.Status.ToString() == "Pending")
                        {
                            <!-- Update -->
                            <a asp-area="Customer"
                               asp-controller="Orders"
                               asp-action="Edit"
                               asp-route-id="@order.Id"
                               class="Update-btn">

                                Update
                                <i class="fa-solid fa-pen"></i>

                            </a>

                            <!-- Delete -->
                            <form asp-area="Customer"
                                  asp-controller="Orders"
                                  asp-action="Delete"
                                  asp-route-id="@order.Id"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this order?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="delete-btn">

                                    
                                    <i class="fa-solid fa-trash"></i>

                                </button>

                            </form>
                        }


                        <!-- Details -->
                        <a asp-area="Customer"
                           asp-controller="Orders"
                           asp-action="Details"
                           asp-route-id="@order.Id"
                           class="details-btn">

                            Details
                            <i class="fa-solid fa-arrow-right"></i>

                        </a>
                    </div>

                </div>
            }

        </div>
    }

</div>