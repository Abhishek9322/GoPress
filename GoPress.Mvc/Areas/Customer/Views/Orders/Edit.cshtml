@model GoPress.Mvc.Areas.Customer.Models.UpdateOrderViewModel

@{
    ViewData["Title"] = "Edit Order";
    Layout = "_Layout";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Edit Order</h2>
            <p class="text-muted">
                Update your pending order.
            </p>
        </div>

        <a asp-area="Customer"
           asp-controller="Orders"
           asp-action="Details"
           asp-route-id="@Model.OrderId"
           class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left"></i>
            Back

        </a>

    </div>


    <form asp-area="Customer"
          asp-controller="Orders"
          asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="OrderId" />


        <!-- ============================
             ORDER INFORMATION
        ============================= -->

        <div class="card mb-4">

            <div class="card-header">
                <h5 class="mb-0">
                    Order Information
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="PickupAddress"
                               class="form-label">
                        </label>

                        <input asp-for="PickupAddress"
                               class="form-control" />

                        <span asp-validation-for="PickupAddress"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="DeliveryAddress"
                               class="form-label">
                        </label>

                        <input asp-for="DeliveryAddress"
                               class="form-control" />

                        <span asp-validation-for="DeliveryAddress"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="PickupDate"
                               class="form-label">
                        </label>

                        <input asp-for="PickupDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="PickupDate"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-12 mb-3">

                        <label asp-for="Notes"
                               class="form-label">
                        </label>

                        <textarea asp-for="Notes"
                                  rows="4"
                                  class="form-control">
                        </textarea>

                    </div>

                </div>

            </div>

        </div>


        <!-- ============================
             ORDER ITEMS
        ============================= -->

        <div class="card mb-4">

            <div class="card-header">

                <h5 class="mb-0">
                    Clothes
                </h5>

            </div>


            <div class="card-body">

                @for (int i = 0; i < Model.OrderItems.Count; i++)
                {

                    <div class="row align-items-center mb-3 p-3 border rounded">


                        <!-- VERY IMPORTANT -->

                        <input type="hidden"
                               asp-for="OrderItems[i].ClothTypeId" />


                        <!-- Cloth Name -->

                        <div class="col-md-4">

                            <label class="form-label">
                                Cloth
                            </label>

                            <input asp-for="OrderItems[i].ClothName"
                                   class="form-control"
                                   readonly />

                        </div>


                        <!-- Price -->

                        <div class="col-md-3">

                            <label class="form-label">
                                Price
                            </label>

                            <input asp-for="OrderItems[i].Price"
                                   class="form-control"
                                   readonly />

                        </div>


                        <!-- Quantity -->

                        <div class="col-md-2">

                            <label class="form-label">
                                Quantity
                            </label>

                            <input asp-for="OrderItems[i].Quantity"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                        </div>


                        <!-- Total -->

                        <div class="col-md-3">

                            <label class="form-label">
                                Total
                            </label>

                            <input asp-for="OrderItems[i].TotalPrice"
                                   class="form-control"
                                   readonly />

                        </div>

                    </div>
                }

            </div>

        </div>


        <!-- ============================
             BUTTONS
        ============================= -->

        <div class="d-flex justify-content-end gap-2">

            <a asp-area="Customer"
               asp-controller="Orders"
               asp-action="Details"
               asp-route-id="@Model.OrderId"
               class="btn btn-outline-secondary">

                Cancel

            </a>


            <button type="submit"
                    class="btn btn-primary">

                <i class="fa-solid fa-floppy-disk"></i>

                Update Order

            </button>

        </div>

    </form>

</div>