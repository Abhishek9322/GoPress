@model GoPress.Mvc.Areas.Customer.Models.CreateOrderViewModel

@{
    ViewData["Title"] = "Create Order";
    Layout = "_Layout";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/customer-create-order.css"
          asp-append-version="true" />
}

<div class="create-order-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="page-header">

        <div>
            <h2>Create New Order</h2>

            <p>
                Select a nearby shop, choose your clothes and create your order.
            </p>
        </div>

    </div>


    <!-- =====================================================
         MAIN LAYOUT
         ===================================================== -->

    <div class="create-order-layout">


        <!-- =================================================
             LEFT PANEL
             ================================================= -->

        <div class="left-panel">


            <!-- =============================================
                 BROWSE SHOP
                 ============================================= -->

            <div class="browse-shop-section">

                <button type="button"
                        id="btnBrowseShops"
                        class="browse-shop-btn">

                    Browse Nearby Shops

                </button>

            </div>


            <!-- =============================================
                 SELECTED SHOP
                 ============================================= -->

            <div class="left-card selected-shop-section">

                <div class="left-card-title">
                    Selected Shop
                </div>

                <input type="hidden"
                       id="ShopOwnerId"
                       asp-for="ShopOwnerId" />


                <div id="selectedShopCard"
                     class="selected-shop-card">

                    <div class="selected-shop-icon">
                        🏪
                    </div>

                    <h5>No Shop Selected</h5>

                    <p>
                        Browse nearby shops to select a shop.
                    </p>

                </div>

            </div>


            <!-- =============================================
                 ORDER INFORMATION
                 ============================================= -->

            <div class="left-card order-information">

                <div class="left-card-title">
                    Order Information
                </div>


                <!-- Pickup Address -->

                <div class="input-group-custom">

                    <label asp-for="PickupAddress">
                        Pickup Address
                    </label>

                    <input asp-for="PickupAddress"
                           id="PickupAddress"
                           class="form-control"
                           placeholder="Enter pickup address" />

                </div>


                <!-- Delivery Address -->

                <div class="input-group-custom">

                    <label asp-for="DeliveryAddress">
                        Delivery Address
                    </label>

                    <input asp-for="DeliveryAddress"
                           id="DeliveryAddress"
                           class="form-control"
                           placeholder="Enter delivery address" />

                </div>


                <!-- Pickup Date -->

                <div class="input-group-custom">

                    <label asp-for="PickupDate">
                        Pickup Date
                    </label>

                    <input asp-for="PickupDate"
                           id="PickupDate"
                           type="date"
                           class="form-control" />

                </div>


                <!-- Notes -->

                <div class="input-group-custom notes-group">

                    <label asp-for="Notes">
                        Notes
                    </label>

                    <textarea asp-for="Notes"
                              id="Notes"
                              rows="5"
                              class="form-control"
                              placeholder="Any special instructions..."></textarea>

                </div>

            </div>

        </div>


        <!-- =================================================
             RIGHT PANEL
             ================================================= -->

        <div class="right-panel">


            <!-- =============================================
                 AVAILABLE SHOPS
                 ============================================= -->

            <div class="right-card available-shop-section">

                <div class="right-card-header">

                    <h4>
                        Available Shop List
                    </h4>

                    <span class="shop-list-subtitle">
                        Select a shop to view its prices
                    </span>

                </div>


                <div id="shopContainer"
                     class="shop-grid">

                    <div class="empty-box">

                        <div class="empty-icon">
                            🏪
                        </div>

                        <strong>
                            Nearby shops will appear here
                        </strong>

                        <span>
                            Click "Browse Nearby Shops" to load shops.
                        </span>

                    </div>

                </div>

            </div>


            <!-- =============================================
                 PRICE LIST
                 ============================================= -->

            <div id="priceListSection"
                 class="right-card price-section">

                <div class="right-card-header">

                    <div>

                        <h4>
                            Shop Price List
                        </h4>

                        <span class="shop-list-subtitle">
                            Select clothes and add them to your order
                        </span>

                    </div>

                </div>


                <div id="priceListContainer"
                     class="price-list-container">

                    <div class="empty-box">

                        <div class="empty-icon">
                            👕
                        </div>

                        <strong>
                            Select a shop first
                        </strong>

                        <span>
                            The shop's available clothes and prices will appear here.
                        </span>

                    </div>

                </div>

            </div>


            <!-- =============================================
                 AVAILABLE CLOTHES
                 ============================================= -->

            <div id="availableClothesSection"
                 class="right-card available-clothes-section"
                 style="display:none;">

                <div class="right-card-header">

                    <div>

                        <h4>
                            Available Clothes Categories List
                        </h4>

                        <span class="shop-list-subtitle">
                            Choose clothes for your order
                        </span>

                    </div>

                </div>


                <div id="availableClothesContainer"
                     class="cloth-grid">
                </div>

            </div>


            <!-- =============================================
                 SELECTED CLOTHES
                 ============================================= -->

            <div class="right-card selected-clothes-section">

                <div class="right-card-header">

                    <div>

                        <h4>
                            Selected Clothes Categories List
                        </h4>

                        <span class="shop-list-subtitle">
                            Your selected clothes and quantities
                        </span>

                    </div>

                </div>


                <div id="selectedItemsContainer"
                     class="selected-items-container">

                    <div class="empty-box">

                        <div class="empty-icon">
                            🛒
                        </div>

                        <strong>
                            No clothes selected
                        </strong>

                        <span>
                            Select clothes from the price list above.
                        </span>

                    </div>

                </div>

            </div>


            <!-- =============================================
                 SUMMARY
                 ============================================= -->

            <div class="order-summary">

                <div class="total-section">

                    <span>
                        Total Amount
                    </span>

                    <strong id="totalAmount">
                        ₹0
                    </strong>

                </div>


                <div class="summary-buttons">

                    <button type="button"
                            id="btnCancelOrder"
                            class="cancel-btn">

                        Cancel

                    </button>


                    <button type="button"
                            id="btnCreateOrder"
                            class="create-order-btn"
                            disabled>

                        Create Order

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =====================================================
     PRICE LIST MODAL
     ===================================================== -->

<div class="modal fade"
     id="priceListModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Shop Price List
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <div id="priceListContainerModal">

                    <div class="text-center">
                        Loading...
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script src="~/js/customer-create-order.js"
            asp-append-version="true"></script>
}