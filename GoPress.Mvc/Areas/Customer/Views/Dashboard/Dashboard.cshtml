@model GoPress.Mvc.Areas.Customer.Models.CustomerDashboardViewModel

@{
    ViewData["Title"] = "Customer Dashboard";
    Layout = "_Layout";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/customer-dashboard.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
}

<div class="dashboard-container">

    <!-- Dashboard Header -->
    <div class="dashboard-header">

        <div class="welcome-content">
            <span class="welcome-label">CUSTOMER DASHBOARD</span>

            <h2>Welcome Back!</h2>

            <p>Track your laundry orders and manage everything in one place.</p>
        </div>

        <div class="dashboard-date">
            <div class="date-icon">
                <i class="fa-regular fa-calendar"></i>
            </div>

            <div>
                <span>Today</span>
                <h6>@DateTime.Now.ToString("dd MMM yyyy")</h6>
            </div>
        </div>

    </div>


    <!-- Dashboard Statistics -->
    <div class="section-heading">

        <div>
            <h3>Order Overview</h3>
            <p>Get a quick overview of your laundry orders.</p>
        </div>

        <span class="total-order-badge">
            <i class="fa-solid fa-box"></i>
            @Model.TotalOrder Total Orders
        </span>

    </div>


    <div class="dashboard-grid">

        <!-- Total Orders -->
        <div class="dashboard-card total-card">

            <div class="card-top">
                <div class="card-icon">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </div>

                <span class="card-status">All Orders</span>
            </div>

            <div class="card-info">
                <h2>@Model.TotalOrder</h2>
                <p>Total Orders</p>
            </div>

            <div class="card-footer">
                <span>Overall orders placed</span>
                <i class="fa-solid fa-arrow-right"></i>
            </div>

        </div>


        <!-- Pending -->
        <div class="dashboard-card pending">

            <div class="card-top">
                <div class="card-icon">
                    <i class="fa-regular fa-clock"></i>
                </div>

                <span class="card-status">Waiting</span>
            </div>

            <div class="card-info">
                <h2>@Model.PendingOrder</h2>
                <p>Pending Orders</p>
            </div>

            <div class="card-footer">
                <span>Awaiting confirmation</span>
                <i class="fa-solid fa-arrow-right"></i>
            </div>

        </div>


        <!-- Accepted -->
        <div class="dashboard-card accepted">

            <div class="card-top">
                <div class="card-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <span class="card-status">Confirmed</span>
            </div>

            <div class="card-info">
                <h2>@Model.AcceptedOrder</h2>
                <p>Accepted Orders</p>
            </div>

            <div class="card-footer">
                <span>Orders accepted by shop</span>
                <i class="fa-solid fa-arrow-right"></i>
            </div>

        </div>


        <!-- Processing -->
        <div class="dashboard-card processing">

            <div class="card-top">
                <div class="card-icon">
                    <i class="fa-solid fa-gears"></i>
                </div>

                <span class="card-status">In Progress</span>
            </div>

            <div class="card-info">
                <h2>@Model.ProceessingOrder</h2>
                <p>Processing Orders</p>
            </div>

            <div class="card-footer">
                <span>Currently being processed</span>
                <i class="fa-solid fa-arrow-right"></i>
            </div>

        </div>


        <!-- Out For Delivery -->
        <div class="dashboard-card delivery">

            <div class="card-top">
                <div class="card-icon">
                    <i class="fa-solid fa-truck-fast"></i>
                </div>

                <span class="card-status">On The Way</span>
            </div>

            <div class="card-info">
                <h2>@Model.OutForDeliveryOrder</h2>
                <p>Out For Delivery</p>
            </div>

            <div class="card-footer">
                <span>Orders on the way</span>
                <i class="fa-solid fa-arrow-right"></i>
            </div>

        </div>


        <!-- Delivered -->
        <div class="dashboard-card success">

            <div class="card-top">
                <div class="card-icon">
                    <i class="fa-solid fa-check-double"></i>
                </div>

                <span class="card-status">Completed</span>
            </div>

            <div class="card-info">
                <h2>@Model.DeliveredOrder</h2>
                <p>Delivered Orders</p>
            </div>

            <div class="card-footer">
                <span>Successfully delivered</span>
                <i class="fa-solid fa-arrow-right"></i>
            </div>

        </div>


        <!-- Cancelled -->
        <div class="dashboard-card danger">

            <div class="card-top">
                <div class="card-icon">
                    <i class="fa-solid fa-ban"></i>
                </div>

                <span class="card-status">Cancelled</span>
            </div>

            <div class="card-info">
                <h2>@Model.CancelledOrder</h2>
                <p>Cancelled Orders</p>
            </div>

            <div class="card-footer">
                <span>Orders cancelled</span>
                <i class="fa-solid fa-arrow-right"></i>
            </div>

        </div>


        <!-- Rejected -->
        <div class="dashboard-card rejected">

            <div class="card-top">
                <div class="card-icon">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>

                <span class="card-status">Rejected</span>
            </div>

            <div class="card-info">
                <h2>@Model.RejectedOrder</h2>
                <p>Rejected Orders</p>
            </div>

            <div class="card-footer">
                <span>Orders not accepted</span>
                <i class="fa-solid fa-arrow-right"></i>
            </div>

        </div>

    </div>


    <!-- =========================================
         BOTTOM DASHBOARD SECTION
    ========================================= -->

    <div class="dashboard-bottom">

        <!-- LEFT SIDE: QUICK ACTIONS -->

        <div class="quick-action-section">

            <div class="quick-action-header">
                <div>
                    <h3>Quick Actions</h3>
                    <p>Manage your activities</p>
                </div>

                <i class="fa-solid fa-bolt action-heading-icon"></i>
            </div>


            <div class="action-list">

                <a asp-area="Customer"
                   asp-controller="Orders"
                   asp-action="Create"
                   class="action-card primary-action">

                    <div class="action-icon">
                        <i class="fa-solid fa-plus"></i>
                    </div>

                    <div class="action-content">
                        <h5>New Order</h5>
                        <p>Place a laundry order</p>
                    </div>

                    <i class="fa-solid fa-chevron-right action-arrow"></i>

                </a>


                <a asp-area="Customer"
                   asp-controller="Orders"
                   asp-action="AllOrders"
                   class="action-card">

                    <div class="action-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </div>

                    <div class="action-content">
                        <h5>My Orders</h5>
                        <p>Track your orders</p>
                    </div>

                    <i class="fa-solid fa-chevron-right action-arrow"></i>

                </a>


                <a asp-area="Customer"
                   asp-controller="Profile"
                   asp-action="Index"
                   class="action-card">

                    <div class="action-icon">
                        <i class="fa-regular fa-user"></i>
                    </div>

                    <div class="action-content">
                        <h5>My Profile</h5>
                        <p>Manage your profile</p>
                    </div>

                    <i class="fa-solid fa-chevron-right action-arrow"></i>

                </a>

            </div>

        </div>


        <!-- RIGHT SIDE: ORDER STATUS OVERVIEW -->

        <div class="order-overview-section">

            <div class="overview-header">

                <div>
                    <h3>Order Status Overview</h3>
                    <p>Track your current order progress</p>
                </div>

                <div class="overview-icon">
                    <i class="fa-solid fa-chart-simple"></i>
                </div>

            </div>


            <div class="order-progress-list">


                <!-- Pending -->

                <div class="progress-item">

                    <div class="progress-info">
                        <span>
                            <i class="fa-regular fa-clock pending-text"></i>
                            Pending
                        </span>

                        <strong>@Model.PendingOrder</strong>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill pending-fill"
                             style="width: @(Model.TotalOrder > 0 ? Math.Min(100, Model.PendingOrder * 100.0 / Model.TotalOrder) : 0)%">
                        </div>
                    </div>

                </div>


                <!-- Accepted -->

                <div class="progress-item">

                    <div class="progress-info">
                        <span>
                            <i class="fa-solid fa-circle-check accepted-text"></i>
                            Accepted
                        </span>

                        <strong>@Model.AcceptedOrder</strong>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill accepted-fill"
                             style="width: @(Model.TotalOrder > 0 ? Math.Min(100, Model.AcceptedOrder * 100.0 / Model.TotalOrder) : 0)%">
                        </div>
                    </div>

                </div>


                <!-- Processing -->

                <div class="progress-item">

                    <div class="progress-info">
                        <span>
                            <i class="fa-solid fa-gears processing-text"></i>
                            Processing
                        </span>

                        <strong>@Model.ProceessingOrder</strong>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill processing-fill"
                             style="width: @(Model.TotalOrder > 0 ? Math.Min(100, Model.ProceessingOrder * 100.0 / Model.TotalOrder) : 0)%">
                        </div>
                    </div>

                </div>


                <!-- Out For Delivery -->

                <div class="progress-item">

                    <div class="progress-info">
                        <span>
                            <i class="fa-solid fa-truck-fast delivery-text"></i>
                            Out For Delivery
                        </span>

                        <strong>@Model.OutForDeliveryOrder</strong>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill delivery-fill"
                             style="width: @(Model.TotalOrder > 0 ? Math.Min(100, Model.OutForDeliveryOrder * 100.0 / Model.TotalOrder) : 0)%">
                        </div>
                    </div>

                </div>


                <!-- Delivered -->

                <div class="progress-item">

                    <div class="progress-info">
                        <span>
                            <i class="fa-solid fa-check-double success-text"></i>
                            Delivered
                        </span>

                        <strong>@Model.DeliveredOrder</strong>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill success-fill"
                             style="width: @(Model.TotalOrder > 0 ? Math.Min(100, Model.DeliveredOrder * 100.0 / Model.TotalOrder) : 0)%">
                        </div>
                    </div>

                </div>

            </div>


            <!-- Overview Footer -->

            <div class="overview-footer">

                <div>
                    <span>Total Orders</span>
                    <h4>@Model.TotalOrder</h4>
                </div>

                <div class="completed-label">
                    <i class="fa-solid fa-circle-check"></i>
                    @Model.DeliveredOrder Completed
                </div>

            </div>

        </div>

    </div>

</div>