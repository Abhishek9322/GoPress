@model GoPress.Mvc.Areas.Customer.Models.CustomerProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";

    var fullName = string.IsNullOrWhiteSpace(Model?.FullName)
        ? "Customer"
        : Model.FullName.Trim();

    var initials = string.Concat(
        fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(x => char.ToUpperInvariant(x[0]))
    );

    var email = string.IsNullOrWhiteSpace(Model?.Email)
        ? "Not provided"
        : Model.Email;

    var phone = string.IsNullOrWhiteSpace(Model?.PhoneNumber)
        ? "Not provided"
        : Model.PhoneNumber;
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/customer-profile.css"
          asp-append-version="true" />
}

<div class="customer-profile-page">

    <!-- PAGE HEADER -->

    <div class="profile-page-header">

        <div class="profile-heading-left">

            <div class="profile-heading-icon">
                <i class="fa-solid fa-user-gear"></i>
            </div>

            <div>
                <span class="profile-heading-label">
                    GOPRESS / CUSTOMER
                </span>

                <h2>My Profile</h2>

                <p>
                    Manage your personal information and account details.
                </p>
            </div>

        </div>

        <a asp-area="Customer"
           asp-controller="Dashboard"
           asp-action="Dashboard"
           class="profile-dashboard-btn">

            <i class="fa-solid fa-arrow-left"></i>
            Back to Dashboard

        </a>

    </div>


    <!-- ALERT MESSAGES -->
    @if (TempData["Error"] != null)
    {
        <div class="profile-alert profile-error">

            <i class="fa-solid fa-circle-exclamation"></i>

            <span>@TempData["Error"]</span>

        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="profile-alert profile-success">

            <i class="fa-solid fa-circle-check"></i>

            <span>@TempData["Success"]</span>

        </div>
    }


    <!-- MAIN PROFILE CONTAINER -->

    <div class="profile-dashboard-layout">


        <!-- LEFT PROFILE CARD -->

        <aside class="profile-sidebar-card">


            <!-- PROFILE COVER -->

            <div class="profile-sidebar-cover">

                <div class="cover-circle cover-circle-one"></div>
                <div class="cover-circle cover-circle-two"></div>

                <div class="cover-brand">
                    <i class="fa-solid fa-shirt"></i>
                    GOPRESS
                </div>

            </div>


            <!-- PROFILE IDENTITY -->

            <div class="profile-sidebar-content">


                <div class="profile-avatar-container">

                    <div class="profile-avatar">
                        @initials
                    </div>

                    <span class="profile-avatar-check">
                        <i class="fa-solid fa-user"></i>
                    </span>

                </div>


                <div class="profile-user-info">

                    <h3>@fullName</h3>

                    <span class="profile-user-role">
                        <i class="fa-solid fa-circle-check"></i>
                        Customer Account
                    </span>

                    <p>
                        Welcome to your GoPress personal account.
                    </p>

                </div>


                <!-- CUSTOMER ID -->

                <div class="profile-id-box">

                    <div>
                        <span>YOUR CUSTOMER ID</span>
                        <strong>#@Model.UserId</strong>
                    </div>

                    <i class="fa-solid fa-fingerprint"></i>

                </div>


                <!-- EDIT PROFILE -->

                <a asp-area="Customer"
                   asp-controller="CustomerProfile"
                   asp-action="GetUpdateCustomerProfile"
                   class="profile-edit-button">

                    <i class="fa-solid fa-pen-to-square"></i>

                    Edit Profile

                    <i class="fa-solid fa-arrow-right edit-arrow"></i>

                </a>


                <div class="profile-sidebar-security">

                    <i class="fa-solid fa-shield-halved"></i>

                    <span>
                        Your personal information is important to us.
                    </span>

                </div>

            </div>

        </aside>



        <!-- RIGHT PROFILE CONTENT -->

        <main class="profile-main-content">


            <!-- INFORMATION HEADER -->

            <div class="profile-content-header">

                <div>

                    <span class="profile-content-eyebrow">
                        ACCOUNT INFORMATION
                    </span>

                    <h3>Personal Details</h3>

                    <p>
                        Your registered information with GoPress.
                    </p>

                </div>

                <div class="profile-content-header-icon">
                    <i class="fa-solid fa-address-card"></i>
                </div>

            </div>


            <!-- PERSONAL INFORMATION -->

            <div class="profile-information-section">

                <div class="profile-section-title">

                    <div class="section-title-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div>
                        <h4>Basic Information</h4>
                        <p>Your personal identification details</p>
                    </div>

                </div>


                <div class="profile-details-grid">


                    <!-- FULL NAME -->

                    <div class="profile-info-card">

                        <div class="info-card-icon">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div class="info-card-details">

                            <span>FULL NAME</span>

                            <h5>
                                @(string.IsNullOrWhiteSpace(Model?.FullName)
                                                                ? "Not provided"
                                                                : Model.FullName)
                            </h5>

                        </div>

                        <div class="info-card-number">01</div>

                    </div>


                    <!-- EMAIL -->

                    <div class="profile-info-card">

                        <div class="info-card-icon">
                            <i class="fa-solid fa-envelope"></i>
                        </div>

                        <div class="info-card-details">

                            <span>EMAIL ADDRESS</span>

                            <h5>@email</h5>

                        </div>

                        <div class="info-card-number">02</div>

                    </div>


                    <!-- PHONE -->

                    <div class="profile-info-card">

                        <div class="info-card-icon">
                            <i class="fa-solid fa-phone"></i>
                        </div>

                        <div class="info-card-details">

                            <span>PHONE NUMBER</span>

                            <h5>@phone</h5>

                        </div>

                        <div class="info-card-number">03</div>

                    </div>


                    <!-- CUSTOMER ID -->

                    <div class="profile-info-card">

                        <div class="info-card-icon">
                            <i class="fa-solid fa-fingerprint"></i>
                        </div>

                        <div class="info-card-details">

                            <span>CUSTOMER ID</span>

                            <h5 class="info-customer-id">
                                #@Model.UserId
                            </h5>

                        </div>

                        <div class="info-card-number">04</div>

                    </div>


                </div>

            </div>



            <!-- ACCOUNT INFORMATION -->

            <div class="profile-account-section">

                <div class="profile-section-title">

                    <div class="section-title-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>

                    <div>
                        <h4>Account & Security</h4>
                        <p>Important information about your account</p>
                    </div>

                </div>


                <div class="profile-security-box">

                    <div class="security-main-icon">
                        <i class="fa-solid fa-lock"></i>
                    </div>

                    <div class="security-content">

                        <h5>Your Information Matters</h5>

                        <p>
                            Your personal details are associated with
                            your GoPress customer account. Keep your
                            contact information updated to receive
                            important order updates and notifications.
                        </p>

                    </div>

                    <div class="security-decoration">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>

                </div>

            </div>



            <!-- BOTTOM INFORMATION -->

            <div class="profile-bottom-bar">

                <div class="profile-bottom-left">

                    <i class="fa-solid fa-circle-check"></i>

                    <span>
                        GoPress Customer Profile
                    </span>

                </div>

                <div class="profile-bottom-brand">

                    GOPRESS

                    <i class="fa-solid fa-shirt"></i>

                </div>

            </div>


        </main>

    </div>

</div>