<nav class="navbar navbar-expand-lg custom-navbar">

    <div class="container">

        <!-- BRAND -->
        <a class="navbar-brand logo-text"
           asp-controller="Home"
           asp-action="Index">

            <span class="logo-icon">
                <i class="fa-solid fa-shirt"></i>
            </span>

            <span>Press & Go</span>

        </a>


        <!-- MOBILE BUTTON -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>


        <!-- NAVIGATION -->
        <div class="collapse navbar-collapse"
             id="mainNavbar">


            <!-- LEFT / CENTER NAVIGATION -->
            <ul class="navbar-nav mx-auto main-nav">


                <!-- HOME -->
                <li class="nav-item">

                    <a class="nav-link"
                       asp-controller="Home"
                       asp-action="Index">

                        <i class="fa-solid fa-house nav-icon"></i>

                        Home

                    </a>

                </li>


                @if (User.Identity?.IsAuthenticated == true)
                {

                    <!-- ========================================= -->
                    <!-- CUSTOMER NAVIGATION -->
                    <!-- ========================================= -->
                    @if (User.IsInRole("Customer"))
                    {
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <i class="fa-solid fa-user nav-icon"></i>

                                My Orders

                            </a>


                            <ul class="dropdown-menu role-dropdown">


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="Customer"
                                       asp-controller="Orders"
                                       asp-action="AllOrders">

                                        <i class="fa-solid fa-list-check"></i>

                                        My Orders

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="Customer"
                                       asp-controller="Orders"
                                       asp-action="Browse">

                                        <i class="fa-solid fa-store"></i>

                                        Browse Shops

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="Customer"
                                       asp-controller="Orders"
                                       asp-action="Create">

                                        <i class="fa-solid fa-plus"></i>

                                        Create Order

                                    </a>
                                </li>


                            </ul>

                        </li>
                    }



                    <!-- ========================================= -->
                    <!-- DELIVERY BOY NAVIGATION -->
                    <!-- ========================================= -->
                    @if (User.IsInRole("DeliveryBoy"))
                    {
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <i class="fa-solid fa-truck-fast nav-icon"></i>

                                Delivery

                            </a>


                            <ul class="dropdown-menu role-dropdown">


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="DeliveryBoy"
                                       asp-controller="Orders"
                                       asp-action="AvailableOrders">

                                        <i class="fa-solid fa-box-open"></i>

                                        Available Orders

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="DeliveryBoy"
                                       asp-controller="Orders"
                                       asp-action="GetAllAcceptPickUpOrders">

                                        <i class="fa-solid fa-hand-holding-box"></i>

                                        Accepted Pickups

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="DeliveryBoy"
                                       asp-controller="Orders"
                                       asp-action="GetAllAcceptPickUpCompeletedOrders">

                                        <i class="fa-solid fa-box"></i>

                                        Pickup Completed

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="DeliveryBoy"
                                       asp-controller="Orders"
                                       asp-action="AllReadyFordeliveryOrders">

                                        <i class="fa-solid fa-box"></i>

                                        Ready For Delivery

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="DeliveryBoy"
                                       asp-controller="Orders"
                                       asp-action="GetOutForDeliveryOrders">

                                        <i class="fa-solid fa-truck"></i>

                                        Out For Delivery

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="DeliveryBoy"
                                       asp-controller="Orders"
                                       asp-action="GetAllDeliveryCompetedOrders">

                                        <i class="fa-solid fa-circle-check"></i>

                                        Completed Orders

                                    </a>
                                </li>


                            </ul>

                        </li>
                    }



                    <!-- ========================================= -->
                    <!-- SHOP OWNER NAVIGATION -->
                    <!-- ========================================= -->
                    @if (User.IsInRole("ShopOwner"))
                    {
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <i class="fa-solid fa-shop nav-icon"></i>

                                Shop Orders

                            </a>


                            <ul class="dropdown-menu role-dropdown">


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="ShopOwner"
                                       asp-controller="Orders"
                                       asp-action="AllOrders">

                                        <i class="fa-solid fa-list"></i>

                                        All Orders

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="ShopOwner"
                                       asp-controller="Orders"
                                       asp-action="AcceptedOrders">

                                        <i class="fa-solid fa-circle-check"></i>

                                        Accepted Orders

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="ShopOwner"
                                       asp-controller="Orders"
                                       asp-action="RejectedOrders">

                                        <i class="fa-solid fa-circle-xmark"></i>

                                        Rejected Orders

                                    </a>
                                </li>


                                <li class="dropdown-divider"></li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="ShopOwner"
                                       asp-controller="Orders"
                                       asp-action="GetCompletePickedUpOrders">

                                        <i class="fa-solid fa-box"></i>

                                        Pickup Completed

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="ShopOwner"
                                       asp-controller="Orders"
                                       asp-action="GetProcessingOrders">

                                        <i class="fa-solid fa-gears"></i>

                                        Processing

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="ShopOwner"
                                       asp-controller="Orders"
                                       asp-action="GetReadyForDelivery">

                                        <i class="fa-solid fa-box-open"></i>

                                        Ready For Delivery

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="ShopOwner"
                                       asp-controller="Orders"
                                       asp-action="GetAllOutForDeliveryOrders">

                                        <i class="fa-solid fa-truck"></i>

                                        Out For Delivery

                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="ShopOwner"
                                       asp-controller="Orders"
                                       asp-action="CompletedOrder">

                                        <i class="fa-solid fa-circle-check"></i>

                                        Completed Orders

                                    </a>
                                </li>


                            </ul>

                        </li>
                    }



                    <!-- ========================================= -->
                    <!-- ADMIN NAVIGATION -->
                    <!-- ========================================= -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                <i class="fa-solid fa-shield-halved nav-icon"></i>

                                Admin

                            </a>


                            <ul class="dropdown-menu role-dropdown">

                                <!--
                                    Add your Admin controller routes here
                                    after you provide the Admin controllers.
                                -->

                                <li>
                                    <span class="dropdown-item-text admin-placeholder">

                                        <i class="fa-solid fa-screwdriver-wrench"></i>

                                        Admin Panel

                                    </span>
                                </li>

                            </ul>

                        </li>
                    }

                }



                <!-- ========================================= -->
                <!-- LOCATIONS -->
                <!-- ========================================= -->

                <li class="nav-item">

                    <a class="nav-link"
                       href="#">

                        <i class="fa-solid fa-location-dot nav-icon"></i>

                        Locations

                    </a>

                </li>


                <!-- ========================================= -->
                <!-- HOW IT WORKS -->
                <!-- ========================================= -->

                <li class="nav-item">

                    <a class="nav-link"
                       href="#">

                        <i class="fa-solid fa-circle-info nav-icon"></i>

                        How It Works

                    </a>

                </li>


            </ul>



            <!-- ========================================= -->
            <!-- RIGHT SIDE -->
            <!-- ========================================= -->

            <div class="navbar-right">


                @if (User.Identity?.IsAuthenticated == true)
                {

                    <!-- USER PROFILE -->
                    <div class="user-dropdown dropdown">

                        <button class="user-profile-btn dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">


                            <span class="user-avatar">

                                <i class="fa-solid fa-user"></i>

                            </span>


                            <span class="user-details">

                                <span class="user-name">

                                    @User.Identity.Name

                                </span>


                                <span class="user-role">

                                    @if (User.IsInRole("Customer"))
                                    {
                                        @:Customer
                                    }
                                    else if (User.IsInRole("ShopOwner"))
                                    {
                                        @:Shop Owner
                                    }
                                    else if (User.IsInRole("DeliveryBoy"))
                                    {
                                        @:Delivery Boy
                                    }
                                    else if (User.IsInRole("Admin"))
                                    {
                                        @:Administrator
                                    }
                                    else
                                    {
                                        @:User
                                    }

                                </span>

                            </span>


                            <i class="fa-solid fa-chevron-down user-chevron"></i>

                        </button>



                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown">


                            <li class="profile-header">

                                <div class="profile-avatar-large">

                                    <i class="fa-solid fa-user"></i>

                                </div>

                                <div>

                                    <div class="profile-name">

                                        @User.Identity.Name

                                    </div>

                                    <div class="profile-role">

                                        @if (User.IsInRole("Customer"))
                                        {
                                            @:Customer
                                        }
                                        else if (User.IsInRole("ShopOwner"))
                                        {
                                            @:Shop Owner
                                        }
                                        else if (User.IsInRole("DeliveryBoy"))
                                        {
                                            @:Delivery Boy
                                        }
                                        else if (User.IsInRole("Admin"))
                                        {
                                            @:Administrator
                                        }
                                        else
                                        {
                                            @:User
                                        }

                                    </div>

                                </div>

                            </li>


                            <li>
                                <hr class="dropdown-divider" />
                            </li>


                            <!-- LOGOUT - UNCHANGED -->
                            <li>

                                <form asp-area="Auth"
                                      asp-controller="Auth"
                                      asp-action="Logout"
                                      method="post">

                                    <button type="submit"
                                            class="dropdown-logout">

                                        <i class="fa-solid fa-right-from-bracket"></i>

                                        Logout

                                    </button>

                                </form>

                            </li>


                        </ul>

                    </div>

                }
                else
                {

                    <!-- SIGN IN -->
                    <a asp-area="Auth"
                       asp-controller="Auth"
                       asp-action="Login"
                       class="signin-link">

                        <i class="fa-solid fa-arrow-right-to-bracket"></i>

                        Sign In

                    </a>


                    <!-- REGISTER -->
                    <a asp-area="Auth"
                       asp-controller="Auth"
                       asp-action="RegisterCustomer"
                       class="get-started-btn">

                        Get Started

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                }

            </div>

        </div>

    </div>

</nav>
