<!-- =========================================================
     NESTED DROPDOWN JAVASCRIPT
========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const submenuToggles =
            document.querySelectorAll(".dropdown-submenu-toggle");


        submenuToggles.forEach(function (toggle) {

            toggle.addEventListener("click", function (e) {

                e.preventDefault();

                e.stopPropagation();


                const parent =
                    toggle.closest(".dropdown-submenu");


                // Close other submenus

                document
                    .querySelectorAll(".dropdown-submenu.show")
                    .forEach(function (submenu) {

                        if (submenu !== parent) {

                            submenu.classList.remove("show");

                        }

                    });


                // Toggle current submenu

                parent.classList.toggle("show");

            });

        });


        // Close nested dropdown when clicking outside

        document.addEventListener("click", function () {

            document
                .querySelectorAll(".dropdown-submenu.show")
                .forEach(function (submenu) {

                    submenu.classList.remove("show");

                });

        });


        // Prevent submenu click from closing Admin dropdown

        document
            .querySelectorAll(".approval-submenu")
            .forEach(function (submenu) {

                submenu.addEventListener("click", function (e) {

                    e.stopPropagation();

                });

            });

    });

</script>